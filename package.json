{
  "name": "cwm-mcp",
  "version": "1.1.0",
  "description": "Cloud World Model is a hosted streamable HTTP MCP server that lets coding agents simulate cloud infrastructure and estimate cost, latency, errors and resilience before deploying or changing infrastructure.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "streamable-http",
    "cloud-simulation",
    "cost-estimation",
    "cloud-cost",
    "finops",
    "multi-cloud",
    "aws",
    "gcp",
    "azure",
    "oci",
    "digitalocean",
    "chaos-engineering",
    "reinforcement-learning",
    "ai-agents",
    "world-model"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/canvascloudai/cwm-mcp.git"
  },
  "homepage": "https://www.cloudworldmodel.ai",
  "bugs": {
    "url": "https://github.com/canvascloudai/cwm-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "smithery.yaml"
  ],
  "bin": {
    "cwm-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/index.js && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0"
  }
}
