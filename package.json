{
  "name": "cwm-mcp",
  "version": "1.0.0",
  "description": "MCP server for Cloud World Model — expose simulation tools to Claude, GPT, and any MCP-compatible AI assistant",
  "type": "module",
  "bin": {
    "cwm-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/index.js && chmod +x dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0"
  }
}
